# Node 24 (default no Render) faz resolução estrita de peer deps e barra o
# install por causa do peer OPCIONAL do vitest@5 (@types/node >=22) vs o
# @types/node@^20 fixado aqui. legacy-peer-deps volta ao comportamento
# tolerante do npm v6 — não altera versões instaladas, só ignora o conflito
# de peer (que é opcional). Necessário pro `npm install` do deploy passar.
legacy-peer-deps=true
