# Copie este arquivo para ".env" e preencha com seus dados reais.

# String de conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/assistencia_tecnica?schema=public"

# Porta em que a API vai rodar
PORT=3333

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório forte)
JWT_SECRET="troque-por-um-segredo-forte-aqui"
JWT_EXPIRES_IN="7d"

# URL do frontend, usada para montar o link de acompanhamento enviado ao
# cliente nas notificações (ex: https://meusistema.com.br)
FRONTEND_URL="http://localhost:5173"

# ----------------------------------------------------------------------------
# STORAGE DE ANEXOS (fotos/laudos da OS)
# ----------------------------------------------------------------------------
# "local" -> grava no disco do servidor (padrão). ⚠️ Em hospedagem com disco
#            efêmero (Render free, serverless) os arquivos SOMEM a cada deploy.
# "s3"     -> grava num bucket compatível com S3 (Cloudflare R2, AWS S3,
#            Backblaze B2, MinIO). Recomendado pra produção.
STORAGE_DRIVER="local"

# Credenciais do bucket — só necessárias se STORAGE_DRIVER="s3".
# Exemplo com Cloudflare R2:
#   S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
#   S3_PUBLIC_URL="https://<bucket>.<accountid>.r2.dev"  (ou domínio custom)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_PUBLIC_URL=""

# ----------------------------------------------------------------------------
# NOTIFICAÇÕES AO CLIENTE (SMS / WhatsApp a cada mudança de status)
# ----------------------------------------------------------------------------

# "console"        -> modo simulado, só imprime a mensagem no log (padrão, não
#                     precisa de nenhuma credencial — bom para desenvolvimento)
# "twilio"         -> envia via Twilio (SMS/WhatsApp)
# "zenvia"         -> envia via Zenvia, gateway BR (SMS/WhatsApp)
# "whatsapp-cloud" -> envia via WhatsApp Cloud API oficial da Meta
NOTIFICATION_PROVIDER="console"

# Canal usado pelos provedores SMS/WhatsApp (twilio/zenvia): "WHATSAPP" ou "SMS"
NOTIFICATION_CHANNEL="WHATSAPP"

# --- Twilio (https://console.twilio.com) — se NOTIFICATION_PROVIDER="twilio" ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Número habilitado para WhatsApp no Twilio Sandbox/produção, com o prefixo:
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Número de SMS da Twilio, formato E.164:
TWILIO_SMS_FROM=""

# --- Zenvia (https://app.zenvia.com) — se NOTIFICATION_PROVIDER="zenvia" ---
ZENVIA_API_TOKEN=""
# Identificador do remetente aprovado na Zenvia (por canal):
ZENVIA_WHATSAPP_FROM=""
ZENVIA_SMS_FROM=""

# --- WhatsApp Cloud API (Meta) — se NOTIFICATION_PROVIDER="whatsapp-cloud" ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
# Fora da janela de 24h a Meta exige TEMPLATE aprovado (1 parâmetro no corpo).
# Informe o nome do template e o locale; deixe vazio para enviar texto livre.
WHATSAPP_CLOUD_TEMPLATE=""
WHATSAPP_CLOUD_TEMPLATE_LANG="pt_BR"
